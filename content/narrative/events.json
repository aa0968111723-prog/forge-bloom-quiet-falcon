    "lines": [
      {
        "when": { "op": "memory", "npcId": "npc-chen-yu", "key": "last", "equals": "asked-map" },
        "text": {
          "zh-Hant": "林可把筆電轉過來，大綱只到第二段。「你在大門問過路。宮燈教室就是那三個點裡面的一個。傳播館的小組今晚要對引用。你若現在走，我不當你拒絕，但我要知道你幾點回來。」"
        }
      },
      {
        "when": { "op": "memory", "npcId": "npc-chen-yu", "key": "last", "equals": "follow-crowd" },
        "text": {
          "zh-Hant": "林可把筆電轉過來。「你是跟著人流上來的。這裡是宮燈教室。大綱只到第二段。我需要知道你是留下，還是先去圖書館。」"
        }
      },
      {
        "text": {
          "zh-Hant": "林可把筆電轉過來，大綱只到第二段。「傳播館的小組今晚要對引用格式。你若現在走，我不當你拒絕，但我要知道你是去找資料，還是只是消失。」"
        }
      }
    ],
    "choices": [
      {
        "id": "palace-stay",
        "text": { "zh-Hant": "我留下，先把第二段對完。" },

    "npcIds": ["npc-chen-yu"],
    "priority": 10,
    "weight": 1,
    "cooldownMinutes": 0,
    "mutexGroup": null,
    "mutexMinutes": 0,
    "once": true,
    "autoFire": false,
    "anomaly": false,
    "evidence": "fictional",
    "lines": [
      {
        "text": {
          "zh-Hant": "陳予站在大門警衛站外，把學生證掛繩轉了一圈。「第一週不用把每棟都記完。你現在是英專路這一側。裡面先認克難坡，坡上是宮燈教室。其餘的等你走錯再問。」"
        }
      }
    ],
    "choices": [
      {
        "id": "gate-ask-map",
        "text": { "zh-Hant": "可以只告訴我今天會用到的路嗎？" },
        "effects": [
          { "type": "set-flag", "flag": "gate-asked-map", "value": true },
          { "type": "remember", "npcId": "npc-chen-yu", "key": "last", "value": "asked-map" },
          { "type": "discover-place", "placeId": "main-gate" },
          { "type": "set-quest-node", "questId": "quest-orient-gate", "node": "done" },
          { "type": "quest-reward", "questId": "quest-orient-gate", "xp": 8, "notes": 1 }
        ],
        "outcome": [
          {
            "text": {
              "zh-Hant": "他指了三個點：大門、克難坡、宮燈教室。「走錯也算認識。你問過，我就記你問過。」"
            }
          }
        ],
        "nextEventId": null
      },
      {
        "id": "gate-follow-crowd",
        "text": { "zh-Hant": "我跟著人流走，迷路再回頭。" },
        "effects": [
          { "type": "set-flag", "flag": "gate-follow-crowd", "value": true },
          { "type": "remember", "npcId": "npc-chen-yu", "key": "last", "value": "follow-crowd" },
          { "type": "discover-place", "placeId": "main-gate" },
          { "type": "set-quest-node", "questId": "quest-orient-gate", "node": "done" },
          { "type": "quest-reward", "questId": "quest-orient-gate", "xp": 8, "notes": 1 }
        ],
        "outcome": [
          {
            "text": {
              "zh-Hant": "「可以。上課鐘前人流會往坡上。你若在宮燈大道中段左右看，書卷廣場還在更裡面。」他沒有要你現在背完整張地圖。"
            }
          }
        ],
        "nextEventId": null
      }
    ],
    "assets": { "images": [], "audio": [], "animation": ["existing:idle"] },

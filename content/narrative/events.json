          { "type": "set-quest-node", "questId": "quest-group-report", "node": "outline" },
          { "type": "quest-reward", "questId": "quest-group-report-join", "xp": 12, "notes": 2 }
        ],
        "outcome": [
          {
            "text": {
              "zh-Hant": "「去圖書館可以。回來時直接講你找到的出處，不要只丟連結。訪談題我先寫。」"

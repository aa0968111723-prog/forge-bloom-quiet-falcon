        "id": "palace-library",
        "text": { "zh-Hant": "我先去圖書館查得出處，再回來講。" },
        "effects": [
          { "type": "set-flag", "flag": "group-library", "value": true },
          { "type": "remember", "npcId": "npc-lin-ke", "key": "pact", "value": "library" },

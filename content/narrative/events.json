      {
        "when": { "op": "flag", "id": "group-library", "equals": true },
        "text": {
          "zh-Hant": "林可已經在總館二樓的流通櫃臺側等你。「你沒有只丟連結，這件事我記著。」周安把兩頁並排。「我們報告裡的兩份敘述對不上。不該挑比較好看的那份。」"
        }
      },
      {
        "when": { "op": "flag", "id": "group-stay", "equals": true },
        "text": {
          "zh-Hant": "林可比昨晚更緊。「你留下對完大綱。可是周安早上帶來一份打架的出處。」周安說：「兩份都先留著。我們還沒有資格宣布哪一份錯。」"
        }
      },
      {
        "text": {
          "zh-Hant": "林可和周安在流通櫃臺側。桌上兩份出處對不上。周安說先並列，不要挑好看的。"
        }
      }
    ],
    "choices": [
      {
        "id": "library-compare",
        "text": { "zh-Hant": "兩份並列，註明各自是哪一年的說法。" },
        "effects": [
          { "type": "set-flag", "flag": "sources-compared", "value": true },
          { "type": "remember", "npcId": "npc-zhou-an", "key": "method", "value": "compare" },
          { "type": "set-quest-node", "questId": "quest-group-report", "node": "sources" },
          { "type": "quest-reward", "questId": "quest-group-report-sources", "xp": 15, "notes": 3 }
        ],
        "outcome": [
          {
            "text": {
              "zh-Hant": "周安把兩頁都留在夾裡。「衝突寫進註腳。結論只保留我們兩人都看過的句子。」林可沒有再問你昨晚人在哪。"
            }
          }
        ],
        "nextEventId": "evt-palace-deadline"
      },
      {
        "id": "library-split",
        "text": { "zh-Hant": "先分開寫，合併前做一欄對照。" },
        "effects": [
          { "type": "set-flag", "flag": "sources-split", "value": true },
          { "type": "remember", "npcId": "npc-zhou-an", "key": "method", "value": "split" },
          { "type": "set-quest-node", "questId": "quest-group-report", "node": "sources" },
          { "type": "quest-reward", "questId": "quest-group-report-sources", "xp": 15, "notes": 3 }
        ],
        "outcome": [
          {
            "text": {
              "zh-Hant": "「分開寫可以。」林可把空白對照欄推過來。「你負責出處，我負責把結論收回我們真的看過的句子。沒有對照欄，我不合。」"
            }
          }
        ],
        "nextEventId": "evt-palace-deadline"
      }
    ],
    "assets": { "images": [], "audio": [], "animation": ["existing:idle"] },
